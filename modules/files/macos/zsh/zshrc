if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

brew_share="${HOMEBREW_PREFIX:-/opt/homebrew}/share"

[[ -r "$brew_share/powerlevel10k/powerlevel10k.zsh-theme" ]] &&
  source "$brew_share/powerlevel10k/powerlevel10k.zsh-theme"

# Run the full compinit security audit at most once a day; otherwise trust the
# existing dump. New completions from brew upgrades show up the next day.
autoload -Uz compinit
zcompdump="${ZDOTDIR:-$HOME}/.zcompdump"
stale_zcompdump=("$zcompdump"(N.mh+24))
if [[ -f $zcompdump && -z $stale_zcompdump ]]; then
  compinit -C -d "$zcompdump"
else
  compinit -d "$zcompdump"
  touch "$zcompdump"
fi
unset zcompdump stale_zcompdump

source "$HOME/.config/zsh/common.zsh"

alias view="nvim -R"

(( $+commands[fzf] )) && source <(fzf --zsh)

[[ -r "$brew_share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] &&
  source "$brew_share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# Has to come after zsh-syntax-highlighting, per its README.
[[ -r "$brew_share/zsh-history-substring-search/zsh-history-substring-search.zsh" ]] &&
  source "$brew_share/zsh-history-substring-search/zsh-history-substring-search.zsh"

unset brew_share
